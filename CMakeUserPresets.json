                "ENABLE_TESTS": "OFF",
                "BUILD_TESTS": "OFF",
                "BUILD_EXAMPLES": "OFF"
            },
            "environment": {
                "TURBOUTILS_ROOT": "$env{PKG_ROOT}/turboutils/release",
