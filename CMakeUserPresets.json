{
    "version": 6,
    "include": [
        "CMakePresets.json"
    ],
    "configurePresets": [
        {
            "name": "win-toolchain",
            "hidden": true,
            "environment": {
                "PROJECT_ROOT": "$penv{PROJECT_ROOT}",
                "PKG_ROOT": "$env{PROJECT_ROOT}/external/pkgs",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
                "VCPKG_ROOT": "$penv{VCPKG_ROOT}"
            }
        },
        {
            "name": "win-paths",
            "hidden": true,
            "inherits": "win-toolchain",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "cacheVariables": {
                "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
                "PKG_CONFIG_EXECUTABLE": "$env{VCPKG_INSTALLED_DIR}/x64-windows/tools/pkgconf/pkgconf.exe",
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "VCPKG_MANIFEST_MODE": "ON"
            },
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            }
        },
        {
            "name": "linux-paths",
            "hidden": true,
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "cacheVariables": {
                "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
                "PKG_CONFIG_EXECUTABLE": "$env{VCPKG_INSTALLED_DIR}/x64-linux/tools/pkgconf/pkgconf",
                "VCPKG_TARGET_TRIPLET": "x64-linux",
                "VCPKG_MANIFEST_MODE": "ON"
            },
            "environment": {
                "PROJECT_ROOT": "$penv{PROJECT_ROOT}",
                "PKG_ROOT": "$env{PROJECT_ROOT}/external/pkgs",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
                "VCPKG_ROOT": "$penv{VCPKG_ROOT}"
            }
        },
        {
            "name": "android-win-environment",
            "hidden": true,
            "inherits": "win-toolchain",
            "environment": {
                "ANDROID_SDK_ROOT": "$penv{LOCALAPPDATA}/Android/Sdk",
                "ANDROID_NDK_VERSION": "28.2.13676358",
                "ANDROID_NDK_HOME": "$env{ANDROID_SDK_ROOT}/ndk/$env{ANDROID_NDK_VERSION}"
            }
        },
        {
            "name": "android-dependencies-debug",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "$env{TURBOUTILS_ROOT}",
                "TURBO_ENABLE_CAPTURE": "ON",
                "VCPKG_MANIFEST_FEATURES": "capture"
            },
            "environment": {
                "TURBOUTILS_ROOT": "$env{PKG_ROOT}/turboutils-android/debug"
            }
        },
        {
            "name": "android-dependencies-release",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "$env{TURBOUTILS_ROOT}",
                "TURBO_ENABLE_CAPTURE": "ON",
                "VCPKG_MANIFEST_FEATURES": "capture"
            },
            "environment": {
                "TURBOUTILS_ROOT": "$env{PKG_ROOT}/turboutils-android/release"
            }
        },
        {
            "name": "win-dev-user",
            "cacheVariables": {
                "ENABLE_SANITIZER_ADDRESS": "ON",
                "CMAKE_INSTALL_PREFIX": "$env{TURBOUTILS_ROOT}",
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows/debug"
            },
            "environment": {
                "TURBOUTILS_ROOT": "$env{PKG_ROOT}/turboutils/debug",
                "PATH": "${sourceDir}/build/Msvc/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{TURBOUTILS_ROOT}/bin${pathListSep}$penv{PATH}"
            },
            "inherits": [
                "base-win-dev-user",
                "win-paths"
            ]
        },
        {
            "name": "win-release-user",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "$env{TURBOUTILS_ROOT}",
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows"
            },
            "environment": {
                "TURBOUTILS_ROOT": "$env{PKG_ROOT}/turboutils/release",
                "PATH": "${sourceDir}/build/Msvc-Release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{TURBOUTILS_ROOT}/bin${pathListSep}$penv{PATH}"
            },
            "inherits": [
                "base-win-release-user",
                "win-paths"
            ]
        },
        {
            "name": "win-capture-dev-user",
            "binaryDir": "${sourceDir}/build/Msvc-Capture",
            "cacheVariables": {
                "TURBO_ENABLE_CAPTURE": "ON",
                "VCPKG_MANIFEST_FEATURES": "capture"
            },
            "environment": {
                "PATH": "${sourceDir}/build/Msvc-Capture/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{TURBOUTILS_ROOT}/bin${pathListSep}$penv{PATH}"
            },
            "inherits": "win-dev-user"
        },
        {
            "name": "win-capture-release-user",
            "binaryDir": "${sourceDir}/build/Msvc-Capture-Release",
            "cacheVariables": {
                "TURBO_ENABLE_CAPTURE": "ON",
                "VCPKG_MANIFEST_FEATURES": "capture"
            },
            "environment": {
                "PATH": "${sourceDir}/build/Msvc-Capture-Release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{TURBOUTILS_ROOT}/bin${pathListSep}$penv{PATH}"
            },
            "inherits": "win-release-user"
        },
        {
            "name": "linux-dev-user",
            "cacheVariables": {
                "ENABLE_SANITIZER_ADDRESS": "ON",
                "CMAKE_INSTALL_PREFIX": "$env{TURBOUTILS_ROOT}",
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux/debug"
            },
            "environment": {
                "TURBOUTILS_ROOT": "$env{PKG_ROOT}/turboutils/debug",
                "PATH": "${sourceDir}/build/linux-gcc-debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/debug/bin${pathListSep}$env{TURBOUTILS_ROOT}/bin${pathListSep}$penv{PATH}",
                "LD_LIBRARY_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux/debug/lib${pathListSep}$env{TURBOUTILS_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
            },
            "inherits": [
                "base-linux-dev-user",
                "linux-paths"
            ]
        },
        {
            "name": "linux-capture-dev-user",
            "binaryDir": "${sourceDir}/build/linux-gcc-capture-debug",
            "cacheVariables": {
                "TURBO_ENABLE_CAPTURE": "ON",
                "VCPKG_MANIFEST_FEATURES": "capture"
            },
            "environment": {
                "PATH": "${sourceDir}/build/linux-gcc-capture-debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/debug/bin${pathListSep}$env{TURBOUTILS_ROOT}/bin${pathListSep}$penv{PATH}"
            },
