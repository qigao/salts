/**
 * @brief Check if optional field is present
 */
static inline bool {{name}}_has_optional_field(const {{name}}_view_t *view, 
                                               {{name}}_optional_field_t field) {
    size_t byte_index;
    uint8_t bit_mask;

    if (!view || !view->data || view->size < {{name}}_PRESENCE_BITMAP_SIZE ||
        field < 0 || field >= {{name}}_OPTIONAL_FIELD_COUNT) {
        return false;
    }

    byte_index = (size_t)field / 8u;
    bit_mask = (uint8_t)(1u << ((unsigned int)field % 8u));
    return (view->data[byte_index] & bit_mask) != 0;
}

/**
 * @brief Set optional field presence in builder
 */
static inline void {{name}}_set_optional_field({{name}}_builder_t *builder,
                                              {{name}}_optional_field_t field) {
    size_t byte_index;
    uint8_t bit_mask;

    if (!builder || !builder->data || builder->size < {{name}}_PRESENCE_BITMAP_SIZE ||
        field < 0 || field >= {{name}}_OPTIONAL_FIELD_COUNT) {
        return;
    }

    byte_index = (size_t)field / 8u;
    bit_mask = (uint8_t)(1u << ((unsigned int)field % 8u));
    builder->data[byte_index] |= bit_mask;
}

/**
 * @brief Clear optional field presence in builder
 */
static inline void {{name}}_clear_optional_field({{name}}_builder_t *builder,
                                                {{name}}_optional_field_t field) {
    size_t byte_index;
    uint8_t bit_mask;

    if (!builder || !builder->data || builder->size < {{name}}_PRESENCE_BITMAP_SIZE ||
        field < 0 || field >= {{name}}_OPTIONAL_FIELD_COUNT) {
        return;
    }

    byte_index = (size_t)field / 8u;
    bit_mask = (uint8_t)(1u << ((unsigned int)field % 8u));
    builder->data[byte_index] &= (uint8_t)~bit_mask;
}

