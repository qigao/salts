/**
 * @brief Host-operation bridge used by generated guest adapters.
 *
 * The caller owns the bridge, context, input, and output buffers. Callbacks
 * return zero on success and otherwise return their provider status unchanged.
 * On success, output_size must not exceed output_capacity. text_to_binary uses
 * csv_row only for CSV; callers pass zero for other formats. Buffer contents
 * are byte slices and are not required to be NUL terminated.
 */
typedef struct tbe_guest_bridge_s {
    uint32_t struct_size;
    uint32_t abi_version;
    void *context;
    int32_t (*text_to_binary)(void *context,
                              const char *schema_id, uint32_t schema_id_len,
                              const char *type_name, uint32_t type_name_len,
                              uint32_t format,
                              const void *input, uint32_t input_len,
                              uint32_t csv_row,
                              void *output, uint32_t output_capacity,
                              uint32_t *output_size);
    int32_t (*binary_to_text)(void *context,
                              const char *schema_id, uint32_t schema_id_len,
                              const char *type_name, uint32_t type_name_len,
                              uint32_t format,
                              const void *input, uint32_t input_len,
                              void *output, uint32_t output_capacity,
                              uint32_t *output_size);
} tbe_guest_bridge_t;

