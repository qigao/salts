#include "{{generated_header}}"

#include <limits.h>

static const char TBE_GUEST_SCHEMA_ID[] = "{{schema.schema_name}}";

static int32_t tbe_guest_size_to_u32(size_t value, uint32_t *out) {
    if (out == NULL) return TBE_GUEST_EINVAL;
    if (value > UINT32_MAX) return TBE_GUEST_EOVERFLOW;
    *out = (uint32_t)value;
    return TBE_GUEST_OK;
}

static int32_t tbe_guest_from_text(const tbe_guest_bridge_t *bridge,
                                   const char *type_name, uint32_t type_name_len,
                                   uint32_t format, uint32_t csv_row,
                                   const void *input, size_t input_len,
                                   uint8_t *wire_output, size_t wire_capacity,
                                   size_t *out_size) {
    uint32_t input_len32;
    uint32_t wire_capacity32;
    uint32_t written = 0;
    int32_t status;

    if (out_size != NULL) *out_size = 0;
    if (bridge == NULL || type_name == NULL || out_size == NULL ||
        (input == NULL && input_len != 0) || wire_output == NULL || wire_capacity == 0)
        return TBE_GUEST_EINVAL;
    if (bridge->struct_size < sizeof(*bridge) ||
        bridge->abi_version != TBE_GUEST_BRIDGE_ABI_VERSION ||
        bridge->text_to_binary == NULL)
        return TBE_GUEST_EBRIDGE;
    status = tbe_guest_size_to_u32(input_len, &input_len32);
    if (status != TBE_GUEST_OK) return status;
    status = tbe_guest_size_to_u32(wire_capacity, &wire_capacity32);
    if (status != TBE_GUEST_OK) return status;

    status = bridge->text_to_binary(
        bridge->context, TBE_GUEST_SCHEMA_ID,
        (uint32_t)(sizeof(TBE_GUEST_SCHEMA_ID) - 1), type_name, type_name_len,
        format, input, input_len32, csv_row, wire_output, wire_capacity32,
        &written);
    *out_size = written;
    if (status != TBE_GUEST_OK) return status;
    if (written > wire_capacity32) return TBE_GUEST_EBRIDGE;
    return TBE_GUEST_OK;
}

static int32_t tbe_guest_to_text(const tbe_guest_bridge_t *bridge,
                                 const char *type_name, uint32_t type_name_len,
                                 uint32_t format, const void *wire_input,
                                 size_t wire_len, char *text_output,
                                 size_t text_capacity, size_t *out_size) {
    uint32_t wire_len32;
    uint32_t text_capacity32;
    uint32_t written = 0;
    int32_t status;

    if (out_size != NULL) *out_size = 0;
    if (bridge == NULL || type_name == NULL || wire_input == NULL || wire_len == 0 ||
        out_size == NULL ||
        (text_output == NULL && text_capacity != 0))
        return TBE_GUEST_EINVAL;
    if (bridge->struct_size < sizeof(*bridge) ||
        bridge->abi_version != TBE_GUEST_BRIDGE_ABI_VERSION ||
        bridge->binary_to_text == NULL)
        return TBE_GUEST_EBRIDGE;
    status = tbe_guest_size_to_u32(wire_len, &wire_len32);
    if (status != TBE_GUEST_OK) return status;
    status = tbe_guest_size_to_u32(text_capacity, &text_capacity32);
    if (status != TBE_GUEST_OK) return status;

    status = bridge->binary_to_text(
        bridge->context, TBE_GUEST_SCHEMA_ID,
        (uint32_t)(sizeof(TBE_GUEST_SCHEMA_ID) - 1), type_name, type_name_len,
        format, wire_input, wire_len32, text_output, text_capacity32, &written);
    *out_size = written;
    if (status != TBE_GUEST_OK) return status;
    if (written > text_capacity32) return TBE_GUEST_EBRIDGE;
    return TBE_GUEST_OK;
}

#define TBE_GUEST_DEFINE_RECORD(record) \
    int32_t record##_guest_from_json(const tbe_guest_bridge_t *bridge, const void *input, size_t input_len, uint8_t *wire_output, size_t wire_capacity, size_t *out_size, record##_view_t *out_view) { \
        int32_t status; \
        if (out_view == NULL) return TBE_GUEST_EINVAL; \
        out_view->data = NULL; \
        out_view->size = 0; \
        status = tbe_guest_from_text(bridge, #record, (uint32_t)(sizeof(#record) - 1), TBE_GUEST_FORMAT_JSON, 0, input, input_len, wire_output, wire_capacity, out_size); \
        if (status != TBE_GUEST_OK) return status; \
        return record##_view_bind(out_view, wire_output, *out_size) ? TBE_GUEST_OK : TBE_GUEST_EWIRE; \
    } \
    int32_t record##_guest_from_yaml(const tbe_guest_bridge_t *bridge, const void *input, size_t input_len, uint8_t *wire_output, size_t wire_capacity, size_t *out_size, record##_view_t *out_view) { \
        int32_t status; \
        if (out_view == NULL) return TBE_GUEST_EINVAL; \
        out_view->data = NULL; \
        out_view->size = 0; \
        status = tbe_guest_from_text(bridge, #record, (uint32_t)(sizeof(#record) - 1), TBE_GUEST_FORMAT_YAML, 0, input, input_len, wire_output, wire_capacity, out_size); \
        if (status != TBE_GUEST_OK) return status; \
        return record##_view_bind(out_view, wire_output, *out_size) ? TBE_GUEST_OK : TBE_GUEST_EWIRE; \
    } \
    int32_t record##_guest_from_csv(const tbe_guest_bridge_t *bridge, const void *input, size_t input_len, size_t csv_row, uint8_t *wire_output, size_t wire_capacity, size_t *out_size, record##_view_t *out_view) { \
        uint32_t csv_row32; \
        int32_t status; \
        if (out_view == NULL) return TBE_GUEST_EINVAL; \
        out_view->data = NULL; \
        out_view->size = 0; \
        status = tbe_guest_size_to_u32(csv_row, &csv_row32); \
        if (status != TBE_GUEST_OK) return status; \
        status = tbe_guest_from_text(bridge, #record, (uint32_t)(sizeof(#record) - 1), TBE_GUEST_FORMAT_CSV, csv_row32, input, input_len, wire_output, wire_capacity, out_size); \
        if (status != TBE_GUEST_OK) return status; \
        return record##_view_bind(out_view, wire_output, *out_size) ? TBE_GUEST_OK : TBE_GUEST_EWIRE; \
    } \
    int32_t record##_guest_from_xml(const tbe_guest_bridge_t *bridge, const void *input, size_t input_len, uint8_t *wire_output, size_t wire_capacity, size_t *out_size, record##_view_t *out_view) { \
        int32_t status; \
        if (out_view == NULL) return TBE_GUEST_EINVAL; \
        out_view->data = NULL; \
        out_view->size = 0; \
        status = tbe_guest_from_text(bridge, #record, (uint32_t)(sizeof(#record) - 1), TBE_GUEST_FORMAT_XML, 0, input, input_len, wire_output, wire_capacity, out_size); \
        if (status != TBE_GUEST_OK) return status; \
        return record##_view_bind(out_view, wire_output, *out_size) ? TBE_GUEST_OK : TBE_GUEST_EWIRE; \
    } \
    int32_t record##_guest_to_json(const tbe_guest_bridge_t *bridge, const record##_view_t *view, char *text_output, size_t text_capacity, size_t *out_size) { \
        if (view == NULL) return TBE_GUEST_EINVAL; \
        return tbe_guest_to_text(bridge, #record, (uint32_t)(sizeof(#record) - 1), TBE_GUEST_FORMAT_JSON, view->data, view->size, text_output, text_capacity, out_size); \
    } \
    int32_t record##_guest_to_yaml(const tbe_guest_bridge_t *bridge, const record##_view_t *view, char *text_output, size_t text_capacity, size_t *out_size) { \
        if (view == NULL) return TBE_GUEST_EINVAL; \
        return tbe_guest_to_text(bridge, #record, (uint32_t)(sizeof(#record) - 1), TBE_GUEST_FORMAT_YAML, view->data, view->size, text_output, text_capacity, out_size); \
    } \
    int32_t record##_guest_to_csv(const tbe_guest_bridge_t *bridge, const record##_view_t *view, char *text_output, size_t text_capacity, size_t *out_size) { \
        if (view == NULL) return TBE_GUEST_EINVAL; \
        return tbe_guest_to_text(bridge, #record, (uint32_t)(sizeof(#record) - 1), TBE_GUEST_FORMAT_CSV, view->data, view->size, text_output, text_capacity, out_size); \
    } \
    int32_t record##_guest_to_xml(const tbe_guest_bridge_t *bridge, const record##_view_t *view, char *text_output, size_t text_capacity, size_t *out_size) { \
        if (view == NULL) return TBE_GUEST_EINVAL; \
        return tbe_guest_to_text(bridge, #record, (uint32_t)(sizeof(#record) - 1), TBE_GUEST_FORMAT_XML, view->data, view->size, text_output, text_capacity, out_size); \
    }

