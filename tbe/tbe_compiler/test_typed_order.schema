schema Orders [id(42), version(1), byte_order(little)];

enum Side <uint8> {
    Buy = 1;
    Sell = 2;
}

composite Header {
    uint32 seq;
}

group Fill {
    int32 price;
    uint32 qty;
}

message Order {
    Header header;
    [name(orderId), alias(oldId), alias(legacyId), c(order_id)] uint32 id;
    int64 min_value;
    uint64 max_value;
    uuid request_id;
    Side side;
    group<Fill> fills;
    string symbol;
    bytes payload;
}
