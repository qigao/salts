{
  "version": 6,
  "include": [
    "../../../CMakeUserPresets.json"
  ],
  "configurePresets": [
    {
      "name": "installed-win-release",
      "inherits": "win-release-user",
      "binaryDir": "${sourceDir}/build/win-release",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/package"
      },
      "environment": {
        "VCPKG_BINARY_SOURCES": "clear;default,readwrite;nugettimeout,1800;nugetconfig,$env{PROJECT_ROOT}/cmake/vcpkg-cache.nuget.config,read",
        "SALTS_ROOT": "$penv{CMETA_PACKAGE_ROOT}"
      }
    },
    {
      "name": "installed-linux-release",
      "inherits": "linux-release-ci",
      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/package"
      },
      "environment": {
        "VCPKG_BINARY_SOURCES": "clear;default,readwrite;nugettimeout,1800;nugetconfig,$env{PROJECT_ROOT}/cmake/vcpkg-cache.nuget.config,read",
        "SALTS_ROOT": "$penv{CMETA_PACKAGE_ROOT}"
      }
    },
    {
      "name": "installed-mac-release",
      "inherits": "mac-release-ci",
      "binaryDir": "${sourceDir}/build/mac-release",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/package"
      },
      "environment": {
        "VCPKG_BINARY_SOURCES": "clear;default,readwrite;nugettimeout,1800;nugetconfig,$env{PROJECT_ROOT}/cmake/vcpkg-cache.nuget.config,read",
        "SALTS_ROOT": "$penv{CMETA_PACKAGE_ROOT}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "installed-win-release",
      "configurePreset": "installed-win-release"
    },
    {
      "name": "installed-linux-release",
      "configurePreset": "installed-linux-release"
    },
    {
      "name": "installed-mac-release",
      "configurePreset": "installed-mac-release"
    }
  ],
  "testPresets": [
    {
      "name": "installed-win-release",
      "configurePreset": "installed-win-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "installed-linux-release",
      "configurePreset": "installed-linux-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "installed-mac-release",
      "configurePreset": "installed-mac-release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
