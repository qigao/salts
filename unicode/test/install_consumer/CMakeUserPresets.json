{
  "version": 6,
  "configurePresets": [
    {
      "name": "installed-sdk",
      "displayName": "Installed Unicode tests with the parent Salts configuration",
      "binaryDir": "$env{SALTS_UNICODE_TEST_BUILD_DIR}",
      "cacheVariables": {
        "VCPKG_MANIFEST_MODE": "ON",
        "CMAKE_FIND_USE_PACKAGE_REGISTRY": "OFF",
        "CMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "installed-sdk",
      "configurePreset": "installed-sdk"
    }
  ],
  "testPresets": [
    {
      "name": "installed-sdk",
      "configurePreset": "installed-sdk",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
