<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       datamodel="null" id="root">
  <initial>
    <transition target="a">
      <if cond="In(root)">
        <if cond="In(a)">
          <raise event="wrong"/>
          <else/>
          <raise event="advance"/>
        </if>
        <else/>
        <raise event="wrong"/>
      </if>
    </transition>
  </initial>
  <state id="parent">
    <initial>
      <transition target="a">
        <raise event="wrong"/>
      </transition>
    </initial>
    <history id="memory">
      <transition target="a">
        <if cond="In(parent)">
          <if cond="In(a)">
            <raise event="wrong"/>
            <else/>
            <raise event="finish"/>
          </if>
          <else/>
          <raise event="wrong"/>
        </if>
      </transition>
    </history>
    <state id="a">
      <onexit>
        <if cond="In(a)">
          <if cond="In(b)">
            <raise event="wrong"/>
            <else/>
            <raise event="exit_ok"/>
          </if>
          <else/>
          <raise event="wrong"/>
        </if>
      </onexit>
      <transition event="advance" target="b">
        <if cond="In(a)">
          <raise event="wrong"/>
          <elseif cond="In(b)"/>
          <raise event="wrong"/>
          <else/>
          <raise event="transition_ok"/>
        </if>
      </transition>
      <transition event="finish" target="done"/>
      <transition event="wrong" target="bad"/>
    </state>
    <state id="b">
      <onentry>
        <if cond="In(b)">
          <if cond="In(a)">
            <raise event="wrong"/>
            <else/>
            <raise event="restore"/>
          </if>
          <else/>
          <raise event="wrong"/>
        </if>
      </onentry>
      <transition event="exit_ok"/>
      <transition event="transition_ok"/>
      <transition event="restore" target="memory"/>
      <transition event="wrong" target="bad"/>
    </state>
  </state>
  <final id="done"/>
  <state id="bad"/>
</scxml>
