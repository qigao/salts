<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       datamodel="null" initial="start">
  <state id="start">
    <onentry>
      <raise event="foo"/>
      <raise event="bar"/>
    </onentry>
    <transition target="p"/>
  </state>
  <parallel id="p">
    <onexit>
      <raise event="parallel.exit"/>
    </onexit>
    <transition event="foo" type="internal" target="ps1"/>
    <transition event="bar" target="observe1"/>
    <state id="ps1">
      <onexit>
        <raise event="first.exit"/>
      </onexit>
    </state>
    <state id="ps2">
      <onexit>
        <raise event="second.exit"/>
      </onexit>
    </state>
  </parallel>
  <state id="observe1">
    <transition event="first.exit parallel.exit" target="fail"/>
    <transition event="second.exit" target="observe2"/>
  </state>
  <state id="observe2">
    <transition event="second.exit parallel.exit" target="fail"/>
    <transition event="first.exit" target="observe3"/>
  </state>
  <state id="observe3">
    <transition event="second.exit first.exit" target="fail"/>
    <transition event="parallel.exit" target="observe4"/>
  </state>
  <state id="observe4">
    <transition event="first.exit parallel.exit" target="fail"/>
    <transition event="second.exit" target="observe5"/>
  </state>
  <state id="observe5">
    <transition event="second.exit parallel.exit" target="fail"/>
    <transition event="first.exit" target="observe6"/>
  </state>
  <state id="observe6">
    <transition event="second.exit first.exit" target="fail"/>
    <transition event="parallel.exit" target="pass"/>
  </state>
  <final id="pass"/>
  <final id="fail"/>
</scxml>
