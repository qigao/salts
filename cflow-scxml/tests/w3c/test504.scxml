<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       datamodel="null" initial="s1">
  <state id="s1">
    <onentry>
      <raise event="foo"/>
      <raise event="bar"/>
    </onentry>
    <transition target="p"/>
  </state>
  <state id="s2">
    <onexit><raise event="s2.exit"/></onexit>
    <parallel id="p">
      <onexit><raise event="p.exit"/></onexit>
      <transition event="foo" type="external" target="ps1"/>
      <transition event="bar" type="external" target="observe1"/>
      <state id="ps1">
        <onexit><raise event="ps1.exit"/></onexit>
      </state>
      <state id="ps2">
        <onexit><raise event="ps2.exit"/></onexit>
      </state>
    </parallel>
  </state>
  <state id="observe1">
    <transition event="ps2.exit" target="observe2"/>
    <transition event="ps1.exit p.exit s2.exit" target="fail"/>
  </state>
  <state id="observe2">
    <transition event="ps1.exit" target="observe3"/>
    <transition event="ps2.exit p.exit s2.exit" target="fail"/>
  </state>
  <state id="observe3">
    <transition event="p.exit" target="observe4"/>
    <transition event="ps1.exit ps2.exit s2.exit" target="fail"/>
  </state>
  <state id="observe4">
    <transition event="ps2.exit" target="observe5"/>
    <transition event="ps1.exit p.exit s2.exit" target="fail"/>
  </state>
  <state id="observe5">
    <transition event="ps1.exit" target="observe6"/>
    <transition event="ps2.exit p.exit s2.exit" target="fail"/>
  </state>
  <state id="observe6">
    <transition event="p.exit" target="observe7"/>
    <transition event="ps1.exit ps2.exit s2.exit" target="fail"/>
  </state>
  <state id="observe7">
    <transition event="s2.exit" target="pass"/>
    <transition event="ps1.exit ps2.exit p.exit" target="fail"/>
  </state>
  <final id="pass"/>
  <final id="fail"/>
</scxml>
