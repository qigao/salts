<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       datamodel="null" initial="start">
  <state id="start">
    <onentry>
      <raise event="foo"/>
      <raise event="bar"/>
    </onentry>
    <transition target="active"/>
  </state>
  <state id="active">
    <onexit>
      <raise event="exited"/>
    </onexit>
    <transition event="foo">
      <raise event="taken"/>
    </transition>
    <transition event="bar" target="observe1"/>
  </state>
  <state id="observe1">
    <transition event="exited" target="fail"/>
    <transition event="taken" target="observe2"/>
  </state>
  <state id="observe2">
    <transition event="taken" target="fail"/>
    <transition event="exited" target="pass"/>
  </state>
  <final id="pass"/>
  <final id="fail"/>
</scxml>
