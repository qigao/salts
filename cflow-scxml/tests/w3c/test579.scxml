<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       datamodel="null" initial="s0">
  <state id="s0">
    <initial>
      <transition target="sh1">
        <raise event="event2"/>
      </transition>
    </initial>
    <onentry>
      <raise event="event1"/>
    </onentry>
    <history id="sh1">
      <transition target="s01">
        <raise event="event3"/>
      </transition>
    </history>
    <state id="s01">
      <transition event="event1" target="s02"/>
      <transition event="event2 event3 leaf.entered" target="fail"/>
    </state>
    <state id="s02">
      <transition event="event2" target="s03"/>
      <transition event="event1 event3 leaf.entered" target="fail"/>
    </state>
    <state id="s03">
      <onentry>
        <raise event="leaf.entered"/>
      </onentry>
      <transition event="event3" target="outside"/>
      <transition event="event1" target="restored.event1"/>
      <transition event="event2" target="fail"/>
    </state>
    <state id="restored.event1">
      <transition event="event2" target="restored.event2"/>
      <transition event="event1 event3 leaf.entered" target="fail"/>
    </state>
    <state id="restored.event2">
      <transition event="leaf.entered" target="pass"/>
      <transition event="event1 event2 event3" target="fail"/>
    </state>
  </state>
  <state id="outside">
    <onentry>
      <raise event="restore"/>
    </onentry>
    <transition event="restore" target="s0"/>
  </state>
  <final id="pass"/>
  <state id="fail"/>
</scxml>
