<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       datamodel="null" initial="s0">
  <state id="s0" initial="s01">
    <transition event="event1" target="fail"/>
    <transition event="event2" target="pass"/>
    <state id="s01">
      <onentry>
        <raise event="event1"/>
      </onentry>
      <transition event="event1" target="s02"/>
      <transition event="event1" target="fail"/>
    </state>
    <state id="s02">
      <onentry>
        <raise event="event2"/>
      </onentry>
      <transition event="event2" cond="In(s01)" target="fail"/>
    </state>
  </state>
  <final id="pass"/>
  <final id="fail"/>
</scxml>
