<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       datamodel="null" initial="s1">
  <state id="s1">
    <onentry>
      <raise event="internalEvent"/>
    </onentry>
    <transition event="internalEvent" target="fail"/>
    <transition target="pass"/>
  </state>
  <final id="pass"/>
  <final id="fail"/>
</scxml>
