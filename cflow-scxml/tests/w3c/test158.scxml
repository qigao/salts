<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       datamodel="null" initial="first">
  <state id="first">
    <onentry>
      <raise event="event1"/>
      <raise event="event2"/>
    </onentry>
    <transition event="event1" target="second"/>
    <transition event="event2" target="fail"/>
  </state>
  <state id="second">
    <transition event="event2" target="pass"/>
    <transition event="event1" target="fail"/>
  </state>
  <final id="pass"/>
  <state id="fail"/>
</scxml>
