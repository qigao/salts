<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       datamodel="null" initial="s0">
  <state id="s0">
    <onentry>
      <send event="blocked" target="peer"/>
    </onentry>
    <onentry>
      <raise event="second.block"/>
    </onentry>
    <transition event="error.execution" target="s1"/>
    <transition event="second.block" target="fail"/>
  </state>
  <state id="s1">
    <transition event="second.block" target="pass"/>
  </state>
  <final id="pass"/>
  <state id="fail"/>
</scxml>
