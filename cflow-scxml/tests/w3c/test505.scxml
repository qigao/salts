<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       datamodel="null" initial="start">
  <state id="start">
    <onentry>
      <raise event="foo"/>
      <raise event="bar"/>
    </onentry>
    <transition target="s1"/>
  </state>
  <state id="s1" initial="s11">
    <onexit>
      <raise event="source.exit"/>
    </onexit>
    <transition event="foo" type="internal" target="s11"/>
    <transition event="bar" target="observe1"/>
    <state id="s11">
      <onexit>
        <raise event="child.exit"/>
      </onexit>
    </state>
  </state>
  <state id="observe1">
    <transition event="source.exit" target="fail"/>
    <transition event="child.exit" target="observe2"/>
  </state>
  <state id="observe2">
    <transition event="source.exit" target="fail"/>
    <transition event="child.exit" target="observe3"/>
  </state>
  <state id="observe3">
    <transition event="child.exit" target="fail"/>
    <transition event="source.exit" target="pass"/>
  </state>
  <final id="pass"/>
  <final id="fail"/>
</scxml>
