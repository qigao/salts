<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       datamodel="null" initial="s0">
  <state id="s0" initial="s01">
    <state id="s01" initial="s011">
      <onexit>
        <if cond="In(s011)">
          <raise event="wrong"/>
        </if>
        <raise event="ready"/>
      </onexit>
      <state id="s011">
        <transition target="s02"/>
      </state>
    </state>
    <state id="s02">
      <transition event="wrong" target="fail"/>
      <transition event="ready" target="pass"/>
    </state>
  </state>
  <final id="pass"/>
  <final id="fail"/>
</scxml>
