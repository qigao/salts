diff --git a/cnet/src/cnet_owner.c b/cnet/src/cnet_owner.c
--- a/cnet/src/cnet_owner.c
+++ b/cnet/src/cnet_owner.c
@@ -1781,6 +1781,18 @@ bool cnet_owner_get_coroutine_stats(const cnet_owner *owner, native_io_coroutine_stats *out_stats) {
   const cnet_owner_impl *impl = owner != NULL ? (const cnet_owner_impl *)owner->impl : NULL;
