{
    "version": 6,
    "include": [
        "presets/BuildPresets.json",
        "presets/TestPresets.json",
        "presets/AndroidPresets.json"
    ],
    "configurePresets": [
        {
            "name": "base-win-dev-user",
            "hidden": true,
            "displayName": "Developer Build (Windows, Base)",
            "inherits": [
                "dev-win-msvc-ninja",
                "pkg-vcpkg"
            ]
        },
        {
            "name": "base-win-release-user",
            "hidden": true,
            "displayName": "Release Build (Windows, Base)",
            "inherits": [
                "release-win-msvc-ninja",
                "pkg-vcpkg"
            ]
        },
        {
            "name": "base-linux-dev-user",
            "hidden": true,
            "displayName": "Developer Build (Linux, Base)",
            "inherits": [
                "dev-linux-ninja",
                "pkg-vcpkg"
            ]
        },
        {
            "name": "base-win-dev-clang-user",
            "hidden": true,
            "displayName": "Developer Build (Windows, Clang, Base)",
            "inherits": [
                "dev-win-clang-ninja",
                "pkg-vcpkg"
            ]
        },
        {
            "name": "base-win-release-clang-user",
            "hidden": true,
            "displayName": "Release Build (Windows, Clang, Base)",
            "inherits": [
                "release-win-clang-ninja",
                "pkg-vcpkg"
            ]
        },
        {
            "name": "formal-linux",
            "displayName": "Formal Conformance (Linux)",
            "inherits": "base-release-linux",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/formal-linux",
            "cacheVariables": {
                "TURBO_FORMAL_ONLY": true,
                "ENABLE_TESTS": false,
                "BUILD_TESTS": false,
                "BUILD_EXAMPLES": false,
                "BUILD_BENCHMARKS": false
            }
        }
    ],
    "buildPresets": [
        {
            "name": "build-formal-linux",
            "displayName": "Build Formal Conformance (Linux)",
            "configurePreset": "formal-linux"
        }
    ]
}
