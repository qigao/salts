#include <winver.h>

1 VERSIONINFO
 FILEVERSION @SALTS_FILE_VERSION_NUMBER@
 PRODUCTVERSION @SALTS_PRODUCT_VERSION_NUMBER@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS $<IF:$<CONFIG:Debug>,VS_FF_DEBUG,0x0L>
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Qi Gao and contributors\0"
            VALUE "FileDescription", "@PROJECT_NAME@ @SALTS_VERSION_COMPONENT@\0"
            VALUE "FileVersion", "@SALTS_FILE_VERSION_STRING@\0"
            VALUE "InternalName", "$<TARGET_FILE_BASE_NAME:@SALTS_VERSION_TARGET@>\0"
            VALUE "OriginalFilename", "$<TARGET_FILE_NAME:@SALTS_VERSION_TARGET@>\0"
            VALUE "ProductName", "@PROJECT_NAME@\0"
            VALUE "ProductVersion", "@SALTS_PRODUCT_VERSION_STRING@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
